{
  "name": "client-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-esbuild.mjs --serve",
    "build": "npm run build:wasm && node scripts/build-esbuild.mjs && node scripts/assert-embed-no-react.mjs",
    "build:wasm": "bash ../relay-runtime/scripts/build-wasm-web.sh",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preflight": "node scripts/preflight-local.mjs",
    "verify:local": "npm run preflight && npm run lint && npm run typecheck && npm test && npm run build",
    "test": "node --experimental-strip-types --experimental-test-module-mocks --test src/tests/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:fan-edits": "playwright test -c playwright-fan-edits.config.ts",
    "serve:fan-edits": "node scripts/serve-fan-edits-gateway.mjs",
    "serve:relay": "npm run build && node scripts/serve-relay.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.49.1",
    "@types/express": "^4.17.21",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.22",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "express": "^4.18.2",
    "globals": "^16.5.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
