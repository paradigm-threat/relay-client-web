# Optional public env for relay-client-web (copy to `.env`).
# `npm run dev` / `npm run build` inject `RELAY_PUBLIC_*` into the bundle.

# Base URL for markdown / assets (no trailing slash required — plugin normalizes)
# RELAY_PUBLIC_FILES_BASE=https://files.example.com

# Master mesh (matches relay-gateway installer DEFAULT_RELAY_MASTER_PEER_LIST)
# RELAY_PUBLIC_MASTER_PEER_LIST="https://iad1.relaygateway.net;https://sjc1.relaygateway.net;https://hkg1.relaygateway.net"

# Static files mirror (align with paradigm-threat-site files origin — first origin is primary)
# RELAY_PUBLIC_FILES_BASE=https://paradigm-threat-files.iad1.relaygateway.net

# Optional: disable embedded video surfaces while stabilizing streaming
# RELAY_PUBLIC_DISABLE_VIDEO=true

# Fullscreen remote hook mode (main bundle): base URL only; default GET hook path is appended.
# Override at runtime with ?relay_preset_hook= or window.RELAY_PUBLIC_PRESET_REMOTE_HOOK
# RELAY_PUBLIC_PRESET_REMOTE_HOOK=http://localhost:3011
