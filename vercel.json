{
  "framework": null,
  "installCommand": "echo 'skip install (static SEO shell)'",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.relaygateway.net" }],
      "destination": "https://relaygateway.net/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(test|debug|embed|hook|wasm|console|transpiler|full-integration|app-with).*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/hooks/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets|wasm|hooks|icon\\.png|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
