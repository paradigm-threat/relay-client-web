{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.relaygateway.net" }],
      "destination": "https://relaygateway.net/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(test|debug|embed|hook|wasm|console|transpiler|full-integration|app-with).*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/hooks/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/((?!assets|wasm|hooks|icon\\.png|robots\\.txt|sitemap\\.xml).*)", "destination": "/index.html" }
  ]
}
