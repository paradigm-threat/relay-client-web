{
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www.relaygateway.net" }],
      "status": 308,
      "headers": { "Location": "https://relaygateway.net/$1" }
    },
    {
      "src": "/index.html",
      "status": 308,
      "headers": { "Location": "/" }
    },
    {
      "src": "/favicon.ico",
      "status": 307,
      "headers": { "Location": "/icon.png" }
    },
    {
      "src": "/(test-.*|debug-.*|embed.*|hooks/.*|wasm-.*|wasm/.*)",
      "headers": { "X-Robots-Tag": "noindex, nofollow" },
      "continue": true
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
