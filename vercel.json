{
  "framework": null,
  "buildCommand": "FORCE_WASM=1 npm run vercel-build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www.relaygateway.net" }],
      "status": 308,
      "headers": { "Location": "https://relaygateway.net/$1" }
    },
    {
      "src": "/index.html",
      "status": 308,
      "headers": { "Location": "/" }
    },
    {
      "src": "/favicon.ico",
      "status": 307,
      "headers": { "Location": "/icon.png" }
    },
    {
      "src": "/info/?",
      "status": 308,
      "headers": { "Location": "/" }
    },
    {
      "src": "/",
      "headers": {
        "X-Hook-Path": "/hooks/client/get.jsx",
        "Access-Control-Expose-Headers": "X-Hook-Path"
      },
      "continue": true
    },
    {
      "src": "/app/?",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "X-Hook-Path": "/hooks/client/get.jsx",
        "Access-Control-Expose-Headers": "X-Hook-Path"
      },
      "continue": true
    },
    { "src": "/app", "dest": "/app/index.html" },
    { "src": "/app/", "dest": "/app/index.html" },
    {
      "src": "/(test-.*|debug-.*|embed.*|hooks/.*|wasm-.*|wasm/.*)",
      "headers": { "X-Robots-Tag": "noindex, nofollow" },
      "continue": true
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
